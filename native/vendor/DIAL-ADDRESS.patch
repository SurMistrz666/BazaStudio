+#[test]
+fn test_dial_address_preserves_server_identity_and_tls_policy() {
+    let endpoint: SocketAddr = "127.0.0.1:32124".parse().unwrap();
+    let original = MySqlConnectOptions::new()
+        .host("database.internal.example")
+        .port(3306)
+        .ssl_mode(MySqlSslMode::VerifyIdentity)
+        .ssl_ca("owned-ca.pem");
+    assert_eq!(original.get_dial_address(), None);
+    let forwarded = original.clone().dial_address(endpoint);
+    assert_eq!(forwarded.get_host(), "database.internal.example");
+    assert_eq!(forwarded.get_port(), 3306);
+    assert!(matches!(
+        forwarded.get_ssl_mode(),
+        MySqlSslMode::VerifyIdentity
+    ));
+    assert!(
+        matches!(&forwarded.ssl_ca, Some(CertificateInput::File(path)) if path == Path::new("owned-ca.pem"))
