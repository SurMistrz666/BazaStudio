+#[test]
+fn test_dial_address_preserves_server_identity_and_tls_policy() {
+    let endpoint: SocketAddr = "127.0.0.1:32123".parse().unwrap();
+    let original = PgConnectOptions::new_without_pgpass()
+        .host("database.internal.example")
+        .port(5432)
+        .ssl_mode(PgSslMode::VerifyFull)
+        .ssl_root_cert("owned-ca.pem");
+    assert_eq!(original.get_dial_address(), None);
+    let forwarded = original.clone().dial_address(endpoint);
+    assert_eq!(forwarded.get_host(), "database.internal.example");
+    assert_eq!(forwarded.get_port(), 5432);
+    assert!(matches!(forwarded.get_ssl_mode(), PgSslMode::VerifyFull));
+    assert!(
+        matches!(&forwarded.ssl_root_cert, Some(CertificateInput::File(path)) if path == Path::new("owned-ca.pem"))
+    );
+    assert_eq!(forwarded.clone().get_dial_address(), Some(endpoint));
+}
