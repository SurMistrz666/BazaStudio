* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.svg text eol=lf
*.png binary
*.icns binary
*.ico binary
*.ttf binary
*.bzx binary
native/THIRD-PARTY-NOTICES.txt -text
native/THIRD-PARTY-INVENTORY.json text eol=lf
native/third-party-licenses/** -text
*.mp4 binary
*.gif binary
*.webp binary
